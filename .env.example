# ==============================================================================
# VARIÁVEIS DE AMBIENTE - PEAT STORE
# ==============================================================================
# Renomeie este arquivo para .env.local para testes locais ou configure 
# diretamente no painel da Vercel (Settings > Environment Variables).

# --- SUPABASE (PostgreSQL & Storage) ---
# Encontrados em: https://supabase.com/dashboard/project/_/settings/api
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# --- MERCADO PAGO (API de Pagamentos & PIX) ---
# Encontrado em: https://www.mercadopago.com.br/developers/panel/app
# Para testes, use a credencial de Teste (TEST-...) ou Produção (APP_USR-...)
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MERCADO_PAGO_WEBHOOK_URL=https://seu-dominio.vercel.app/api/webhook-mercadopago

# --- MELHOR ENVIO (Cálculo de Frete e Prazos) ---
# Sandbox: https://sandbox.melhorenvio.com.br/painel/gerenciar/tokens
# Produção: https://melhorenvio.com.br/painel/gerenciar/tokens
MELHOR_ENVIO_TOKEN=seu_token_jwt_do_melhor_envio_aqui
MELHOR_ENVIO_CEP_ORIGEM=01001000
MELHOR_ENVIO_SANDBOX=false
